    <script is:inline>
      // Scroll reveal
      const reveal = () => {
        const reveals = document.querySelectorAll(".reveal, .open-reveal");
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        reveals.forEach((el) => {
          if (reduceMotion) {
            el.classList.add("active");
            return;
          }

          const windowHeight = window.innerHeight;
          const elementTop = el.getBoundingClientRect().top;
          const elementVisible = 100;
          if (elementTop < windowHeight - elementVisible) {
            el.classList.add("active");
          }
        });
      };
      window.addEventListener("scroll", reveal);
      window.addEventListener("load", reveal);

      // Přepínání záložek ceníku (Dámy, Páni, Děti)
      window.switchTab = function (tabName) {
        document.querySelectorAll(".tab-btn").forEach((btn) => {
          const isActive = btn.id === "tab-" + tabName;
          btn.classList.toggle("active", isActive);
          btn.setAttribute("aria-selected", isActive ? "true" : "false");
          btn.tabIndex = isActive ? 0 : -1;
        });
        document.querySelectorAll(".tab-content").forEach((content) => {
          content.classList.toggle("hidden", content.id !== "content-" + tabName);
        });
      };

      const tabList = document.querySelector('[role="tablist"]');
      if (tabList) {
        tabList.addEventListener("keydown", (event) => {
          const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
          const currentIndex = tabs.indexOf(document.activeElement);
          if (currentIndex === -1) return;

          let nextIndex = null;
          if (event.key === "ArrowRight") {
            nextIndex = (currentIndex + 1) % tabs.length;
          } else if (event.key === "ArrowLeft") {
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          }
          if (nextIndex === null) return;

          event.preventDefault();
          const tabName = tabs[nextIndex].id.replace(/^tab-/, "");
          window.switchTab(tabName);
          tabs[nextIndex].focus();
        });
      }

      const hairGroup = document.querySelector('[aria-label="Délka vlasů"]');
      let selectedHairLength = null;

      function applyHairPrices() {
        const key = selectedHairLength || "full";
        document.querySelectorAll(".js-length-price").forEach((el) => {
          el.textContent = el.dataset[key] || el.dataset.full;
        });
        document.querySelectorAll(".js-length-hint").forEach((el) => {
          el.textContent = el.dataset[key] || el.dataset.full;
        });
      }

      window.selectHairLength = function (length) {
        selectedHairLength = length;
        document.querySelectorAll(".hair-option").forEach((btn) => {
          const isSelected = btn.dataset.hair === length;
          btn.setAttribute("aria-checked", isSelected ? "true" : "false");
        });
        applyHairPrices();
      };
      if (hairGroup) {
        hairGroup.addEventListener("keydown", (event) => {
          const options = Array.from(hairGroup.querySelectorAll(".hair-option"));
          const currentIndex = options.indexOf(document.activeElement);
          if (currentIndex === -1) return;

          let nextIndex = null;
          if (event.key === "ArrowRight") {
            nextIndex = (currentIndex + 1) % options.length;
          } else if (event.key === "ArrowLeft") {
            nextIndex = (currentIndex - 1 + options.length) % options.length;
          }
          if (nextIndex === null) return;

          event.preventDefault();
          const length = options[nextIndex].dataset.hair;
          window.selectHairLength(length);
          options[nextIndex].focus();
        });
      }
    </script>

    <script>
      const track = document.getElementById("gallery-track");
      const originalSlides = Array.from(
        document.querySelectorAll(".gallery-slide"),
      );

      const prevButton = document.getElementById("gallery-prev");
      const nextButton = document.getElementById("gallery-next");

      let currentIndex = 3;
      let isAnimating = false;

      // Duplikujeme první 3 a poslední 3 fotky
      const slidesPerView = 3;

      const firstClones = originalSlides
        .slice(0, slidesPerView)
        .map((slide) => slide.cloneNode(true));

      const lastClones = originalSlides
        .slice(-slidesPerView)
        .map((slide) => slide.cloneNode(true));

      // Přidáme kopie na začátek
      lastClones.reverse().forEach((slide) => {
        track.insertBefore(slide, track.firstChild);
      });

      // Přidáme kopie na konec
      firstClones.forEach((slide) => {
        track.appendChild(slide);
      });

      const slides = Array.from(track.querySelectorAll(".gallery-slide"));

      function updateCarousel(animate = true) {
        const slideWidth = slides[0].getBoundingClientRect().width;
        const gap = 24;

        track.style.transition = animate
          ? "transform 500ms ease-in-out"
          : "none";

        track.style.transform = `translateX(-${currentIndex * (slideWidth + gap)}px)`;
      }

      nextButton.addEventListener("click", () => {
        if (isAnimating) return;

        isAnimating = true;
        currentIndex++;

        updateCarousel(true);
      });

      prevButton.addEventListener("click", () => {
        if (isAnimating) return;

        isAnimating = true;
        currentIndex--;

        updateCarousel(true);
      });

      track.addEventListener("transitionend", () => {
        const originalLength = originalSlides.length;

        // Jsme za poslední skutečnou fotkou
        if (currentIndex >= originalLength + slidesPerView) {
          currentIndex = slidesPerView;

          updateCarousel(false);
        }

        // Jsme před první skutečnou fotkou
        if (currentIndex < slidesPerView) {
          currentIndex = originalLength + slidesPerView - 1;

          updateCarousel(false);
        }

        isAnimating = false;
      });

      window.addEventListener("resize", () => {
        updateCarousel(false);
      });

      // Začínáme na první skutečné fotce
      updateCarousel(false);
    </script>

    <script>
      const copyPhone = document.getElementById("copy-phone");
      const phoneCopyText = document.getElementById("phone-copy-text");

      copyPhone.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("604 172 884");

          phoneCopyText.textContent = "✓ Číslo zkopírováno";

          setTimeout(() => {
            phoneCopyText.textContent = "Zkopírovat číslo";
          }, 2000);
        } catch (error) {
          console.error("Nepodařilo se zkopírovat číslo:", error);
        }
      });
    </script>
