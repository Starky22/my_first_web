---
import "../styles/global.css";
import salonHero from "../assets/salon.jpg?url";
---

<!doctype html>
<html class="scroll-smooth" lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Kadeřnictví Petra</title>
    <noscript>
      <style>
        .reveal,
        .open-reveal,
        .custom-reveal {
          opacity: 1;
          transform: none;
          clip-path: none;
          animation: none;
        }
      </style>
    </noscript>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@400;500;700&family=Playfair+Display:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="bg-background text-on-surface font-body-md selection:bg-primary/20"
  >
    <nav
      class="glass-nav border-outline-variant/20 px-gutter fixed top-0 z-50 w-full border-b py-1 transition-all duration-300"
    >
      <div
        class="max-w-container-max mx-auto flex items-center justify-between"
      >
        <a
          class="font-headline-sm text-primary group flex items-center gap-2"
          href="#"
        >
          <img
            alt="KP Logo"
            class="h-17 w-17 scale-110 object-contain transition-transform group-hover:scale-125"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuB1pYNkVrumGXcnG3Kms4rFIhsT5kG6saj7xoUtZ63DrJjAv5G4hMklzhM-FdvH-nPSCr6hnLcUsIUtqe379i5Q_mJbewCsJPswSdtFvLt1WXZ068eVZLqM0gDgwz94XGCoAwM-y8OXiUwrR28V2YmInJlJGL5xNHZr6BwYttHBjTfipW8egmPyLLQUsGlndOvGaNtKPnImzoKALFtVtLIENmcDjin1TTgCyyYtXSL4oO9M7ikSELh5bWQd_zEwFvg2VQ"
          />
          <span class="font-Inter text-xl tracking-tight md:text-3xl"
            >Kadeřnictví Petra</span
          >
        </a>
        <div
          class="font-Inter hidden items-center gap-8 tracking-wider uppercase md:flex"
        >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#o-nas">O nás</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#sluzby">Služby & Ceník</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#galerie">Galerie</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#recenze">Recenze</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#kontakt">Kontakt</a
          >
        </div>
        <a
          class="bg-primary text-on-primary font-Inter hover:bg-primary/90 rounded-full px-6 py-2 shadow-md transition-all"
          href="#kontakt"
        >
          REZERVACE
        </a>
      </div>
    </nav>

    <header
      class="relative flex h-screen items-center justify-center overflow-hidden"
    >
      <div class="absolute inset-0 z-0">
        <img
          alt="Interiér salónu"
          class="h-full w-full object-cover"
          src={salonHero}
        />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div
        class="px-gutter relative z-10 flex flex-col items-center text-center"
      >
        <p
          class="font-Inter reveal active mb-12 text-2xl text-white italic drop-shadow-md"
          style="transition-delay: 400ms;"
        >
          Vaše vlasy, moje péče
        </p>
        <div
          class="reveal active flex flex-col gap-6 sm:flex-row"
          style="transition-delay: 600ms;"
        >
          <a
            class="bg-primary text-on-primary font-Inter rounded-full px-10 py-4 tracking-widest shadow-xl transition-transform hover:scale-105"
            href="#kontakt"
          >
            REZERVOVAT TERMÍN
          </a>
          <a
            class="text-primary border-primary/20 font-Inter rounded-full border bg-white/90 px-10 py-4 tracking-widest shadow-lg backdrop-blur-sm transition-all hover:bg-white"
            href="#sluzby"
          >
            PROHLÉDNOUT CENÍK
          </a>
        </div>
      </div>
    </header>

    <section
      class="py-stack-lg px-gutter max-w-container-max mx-auto"
      id="o-nas"
    >
      <div class="gap-stack-md grid items-center md:grid-cols-2">
        <div class="reveal active relative">
          <div
            class="relative z-10 aspect-[4/5] overflow-hidden rounded-xl shadow-2xl"
          >
            <img
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBRBg3XIWUoLvXjOcWo4Qk3ZjoYxcAfZeD9aoH4pq84X52FbCKdIRQxT_EZvQ8qBPZYVRanXmWWl93Zz87BBOULcYg3qdAnEanN1Z8WQnAOdIKktCEqpe-j6XMuBvE7Yeu20y7W6KLItNX5kCeIZRYn7QOjqjlE7xNp7Lz3jDalyFaWK4GTYj5NTaW0RLcl0cBbUEum7SlauFB6StG4GMre_YGLG3CvUCkd75m_ChK0zkcOXL86R6xtrQ"
              alt="Petra Kavková - majitelka salónu"
              class="h-full w-full object-cover transition-transform duration-500 ease-in-out hover:scale-110"
            />
          </div>
          <div
            class="bg-primary-fixed-dim/30 absolute -bottom-6 -left-6 -z-10 h-48 w-48 rounded-full blur-3xl"
          >
          </div>
          <div
            class="bg-secondary-container/20 absolute -top-6 -right-6 -z-10 h-64 w-64 rounded-full blur-3xl"
          >
          </div>
        </div>
        <div class="reveal active">
          <span
            class="text-primary font-Inter mb-4 block tracking-[0.2em] uppercase"
            >Příběh elegance</span
          >
          <h2 class="font-Inter text-on-surface mb-6 text-3xl">
            O mně a mém salónu
          </h2>
          <div
            class="font-Inter text-on-surface-variant space-y-6 leading-relaxed"
          >
            <div class="">
              Lorem ipsum dolor sit amet. At ipsum accusantium sed ipsam
              nesciunt At molestiae quod. Est possimus molestiae est voluptatum
              eveniet vel rerum omnis sit optio assumenda et ipsam maiores ad
              accusantium nihil qui consequatur quis.
            </div>
            <div class="">
              Sit nostrum eveniet qui impedit magnam est officia voluptas ut
              quia internos est inventore molestiae est fuga minus! Ut neque
              reiciendis eum ducimus quae est dolor iste sed dolorum pariatur.
            </div>
            <div class="">
              Ut error quaerat in iusto possimus a inventore molestias. Est
              saepe quas cum minus sequi ab placeat temporibus aut totam nihil
              sed iusto deleniti.
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-stack-lg bg-surface-container-low" id="sluzby">
      <div class="max-w-container-max px-gutter mx-auto">
        <div class="reveal active mb-16 text-center">
          <span
            class="text-primary font-Inter mb-4 block tracking-[0.2em] uppercase"
            >Služby & Ceník</span
          >
          <h2 class="font-Inter text-on-surface text-3xl">
            Péče, kterou si zasloužíte
          </h2>
        </div>

        <div class="mb-12" role="radiogroup" aria-label="Délka vlasů">
          <div
            class="mx-auto grid w-full max-w-md grid-cols-3 gap-2 sm:max-w-lg sm:gap-3 md:max-w-xl"
          >
            <button
              type="button"
              role="radio"
              aria-checked="false"
              aria-label="Krátké vlasy"
              data-hair="kratek"
              class="hair-option overflow-hidden rounded-2xl bg-white shadow-sm"
              onclick="selectHairLength('kratek')"
            >
              <span class="relative block aspect-[3/4] overflow-hidden">
                <img
                  alt=""
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBR5G8awWpRAmoa-AvVPU7tm_42KFnbp_VllxNrCKgzujCuv1b8c1lVF-EFB6jW3cMw9YKj4sfOrss9iofL5XhfyrabyarTztGGyqUgQ8nhhmxluXzebFxQ_EZd6Bv-vvLuf3R_NN6-aiX2wwDfSh0l1DrdoKKTVcg1vubYltpr-fAd5dwa-bHS_KT94_CZUW_iNkzUH3TyHv2ci-91O9QojH-Nd9WupEbksXsUNyfbY9JhDFNQassvfA3Op5c7hJ9EKBg"
                  class="absolute inset-y-0 left-0 h-full w-[300%] max-w-none object-cover"
                />
              </span>
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              aria-label="Střední vlasy"
              data-hair="stredni"
              class="hair-option overflow-hidden rounded-2xl bg-white shadow-sm"
              onclick="selectHairLength('stredni')"
            >
              <span class="relative block aspect-[3/4] overflow-hidden">
                <img
                  alt=""
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBR5G8awWpRAmoa-AvVPU7tm_42KFnbp_VllxNrCKgzujCuv1b8c1lVF-EFB6jW3cMw9YKj4sfOrss9iofL5XhfyrabyarTztGGyqUgQ8nhhmxluXzebFxQ_EZd6Bv-vvLuf3R_NN6-aiX2wwDfSh0l1DrdoKKTVcg1vubYltpr-fAd5dwa-bHS_KT94_CZUW_iNkzUH3TyHv2ci-91O9QojH-Nd9WupEbksXsUNyfbY9JhDFNQassvfA3Op5c7hJ9EKBg"
                  class="absolute inset-y-0 left-[-100%] h-full w-[300%] max-w-none object-cover"
                />
              </span>
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              aria-label="Dlouhé vlasy"
              data-hair="dlouhe"
              class="hair-option overflow-hidden rounded-2xl bg-white shadow-sm"
              onclick="selectHairLength('dlouhe')"
            >
              <span class="relative block aspect-[3/4] overflow-hidden">
                <img
                  alt=""
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBR5G8awWpRAmoa-AvVPU7tm_42KFnbp_VllxNrCKgzujCuv1b8c1lVF-EFB6jW3cMw9YKj4sfOrss9iofL5XhfyrabyarTztGGyqUgQ8nhhmxluXzebFxQ_EZd6Bv-vvLuf3R_NN6-aiX2wwDfSh0l1DrdoKKTVcg1vubYltpr-fAd5dwa-bHS_KT94_CZUW_iNkzUH3TyHv2ci-91O9QojH-Nd9WupEbksXsUNyfbY9JhDFNQassvfA3Op5c7hJ9EKBg"
                  class="absolute inset-y-0 left-[-200%] h-full w-[300%] max-w-none object-cover"
                />
              </span>
            </button>
          </div>
        </div>

        <div class="reveal active mb-12 flex justify-center">
          <div
            class="border-outline-variant/30 inline-flex rounded-full border bg-white/50 p-1"
            role="tablist"
            aria-label="Kategorie ceníku"
          >
            <button
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="content-damy"
              tabindex="0"
              class="tab-btn font-Inter active rounded-full px-8 py-2 tracking-widest uppercase transition-all"
              id="tab-damy"
              onclick="switchTab('damy')">Dámy</button
            >
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="content-pani"
              tabindex="-1"
              class="tab-btn font-Inter rounded-full px-8 py-2 tracking-widest uppercase transition-all"
              id="tab-pani"
              onclick="switchTab('pani')">Páni</button
            >
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="content-deti"
              tabindex="-1"
              class="tab-btn font-Inter rounded-full px-8 py-2 tracking-widest uppercase transition-all"
              id="tab-deti"
              onclick="switchTab('deti')">Děti</button
            >
          </div>
        </div>

        <div class="mx-auto max-w-5xl">
          <div
            class="tab-content flex flex-col gap-12"
            id="content-damy"
            role="tabpanel"
            aria-labelledby="tab-damy"
          >
            <div class="reveal active">
              <h3
                class="font-Inter text-primary border-primary/20 mb-6 border-b pb-2 text-2xl"
              >
                Střihy a Mytí
              </h3>
              <div class="space-y-4">
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <p class="font-bold">Mytí <span class="js-length-hint" data-full="(krátké / střední / dlouhé)" data-kratek="(krátké)" data-stredni="(střední)" data-dlouhe="(dlouhé)">(krátké / střední / dlouhé)</span></p><span
                    class="price-leader"
                    aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full="110 / 120 / 130 Kč"
                    data-kratek="110 Kč"
                    data-stredni="120 Kč"
                    data-dlouhe="130 Kč"
                    >110 / 120 / 130 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <p class="font-bold">Stříhání (klasické / módní)</p><span
                    class="price-leader"
                    aria-hidden="true"></span><span
                    class="text-primary shrink-0 font-bold whitespace-nowrap"
                    >140 / 240-300 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <p class="font-bold">Stříhání konečků</p><span
                    class="price-leader"
                    aria-hidden="true"></span><span
                    class="text-primary shrink-0 font-bold whitespace-nowrap"
                    >110 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <button
                    type="button"
                    class="group relative cursor-help border-0 bg-transparent p-0 text-left font-[inherit] font-bold text-inherit"
                  >
                    Efilace<span
                      class="text-primary/50 material-symbols-outlined ml-1 align-middle text-[16px]"
                      >info</span
                    ><span
                      class="bg-surface-container-highest text-on-surface border-outline-variant/30 pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-64 -translate-x-1/2 rounded-xl border p-3 text-xs font-normal opacity-0 shadow-xl price-tooltip transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
                      >Speciální technika prostříhávání vlasů pro odlehčení
                      účesu a dodání textury.</span>
                  </button><span class="price-leader" aria-hidden="true"></span><span
                    class="text-primary shrink-0 font-bold whitespace-nowrap"
                    >90 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <p class="font-bold">Společenský účes</p><span
                    class="price-leader"
                    aria-hidden="true"></span><span
                    class="text-primary shrink-0 font-bold whitespace-nowrap"
                    >400 - 1500 Kč</span>
                </div>
              </div>
            </div>
            <div class="reveal active">
              <h3
                class="font-Inter text-primary border-primary/20 mb-6 border-b pb-2 text-2xl"
              >
                Foukaná a Vodová
              </h3>
              <div class="space-y-4">
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <button
                    type="button"
                    class="group relative cursor-help border-0 bg-transparent p-0 text-left font-[inherit] font-bold text-inherit"
                  >
                    Foukaná <span class="js-length-hint" data-full="(krátké / střední / dlouhé)" data-kratek="(krátké)" data-stredni="(střední)" data-dlouhe="(dlouhé)">(krátké / střední / dlouhé)</span><span
                      class="text-primary/50 material-symbols-outlined ml-1 align-middle text-[16px]"
                      >info</span
                    ><span
                      class="bg-surface-container-highest text-on-surface border-outline-variant/30 pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-64 -translate-x-1/2 rounded-xl border p-3 text-xs font-normal opacity-0 shadow-xl price-tooltip transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
                      >Styling účesu přes kulatý kartáč pro dokonalý tvar a
                      lesk.</span>
                  </button><span class="price-leader" aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full="160 / 180 / 220 Kč"
                    data-kratek="160 Kč"
                    data-stredni="180 Kč"
                    data-dlouhe="220 Kč"
                    >160 / 180 / 220 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <button
                    type="button"
                    class="group relative cursor-help border-0 bg-transparent p-0 text-left font-[inherit] font-bold text-inherit"
                  >
                    Vodová <span class="js-length-hint" data-full="(krátké / střední / dlouhé)" data-kratek="(krátké)" data-stredni="(střední)" data-dlouhe="(dlouhé)">(krátké / střední / dlouhé)</span><span
                      class="text-primary/50 material-symbols-outlined ml-1 align-middle text-[16px]"
                      >info</span
                    ><span
                      class="bg-surface-container-highest text-on-surface border-outline-variant/30 pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-64 -translate-x-1/2 rounded-xl border p-3 text-xs font-normal opacity-0 shadow-xl price-tooltip transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
                      >Klasická technika tvarování účesu pomocí natáček pro
                      dlouhotrvající efekt.</span>
                  </button><span class="price-leader" aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full="290 / 310 / 410 Kč"
                    data-kratek="290 Kč"
                    data-stredni="310 Kč"
                    data-dlouhe="410 Kč"
                    >290 / 310 / 410 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <p class="font-bold">Sušení</p><span
                    class="price-leader"
                    aria-hidden="true"></span><span
                    class="text-primary shrink-0 font-bold whitespace-nowrap"
                    >220 - 300 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <p class="font-bold">
                    Žehlení <span class="js-length-hint" data-full="(krátké / střední / dlouhé)" data-kratek="(krátké)" data-stredni="(střední)" data-dlouhe="(dlouhé)">(krátké / střední / dlouhé)</span>
                  </p><span class="price-leader" aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full="150 / 170 / 260 Kč"
                    data-kratek="150 Kč"
                    data-stredni="170 Kč"
                    data-dlouhe="260 Kč"
                    >150 / 170 / 260 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <button
                    type="button"
                    class="group relative cursor-help border-0 bg-transparent p-0 text-left font-[inherit] font-bold text-inherit"
                  >
                    Loknování <span class="js-length-hint" data-full="(krátké - střední / dlouhé)" data-kratek="(krátké)" data-stredni="(střední)" data-dlouhe="(dlouhé)">(krátké - střední / dlouhé)</span><span
                      class="text-primary/50 material-symbols-outlined ml-1 align-middle text-[16px]"
                      >info</span
                    ><span
                      class="bg-surface-container-highest text-on-surface border-outline-variant/30 pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-64 -translate-x-1/2 rounded-xl border p-3 text-xs font-normal opacity-0 shadow-xl price-tooltip transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
                      >Profesionální tvorba vln a loken pro přirozený objem.</span>
                  </button><span class="price-leader" aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full="260 / 380 Kč"
                    data-kratek="260 Kč"
                    data-stredni="260 Kč"
                    data-dlouhe="380 Kč"
                    >260 / 380 Kč</span>
                </div>
              </div>
            </div>
            <div class="reveal active">
              <h3
                class="font-Inter text-primary border-primary/20 mb-6 border-b pb-2 text-2xl"
              >
                Barvení a Melíry
              </h3>
              <div class="space-y-4">
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <p class="font-bold">
                    Barvení <span class="js-length-hint" data-full="(krátké / střední / dlouhé)" data-kratek="(krátké)" data-stredni="(střední)" data-dlouhe="(dlouhé)">(krátké / střední / dlouhé)</span>
                  </p><span class="price-leader" aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full="450 / 500 / 670 Kč"
                    data-kratek="450 Kč"
                    data-stredni="500 Kč"
                    data-dlouhe="670 Kč"
                    >450 / 500 / 670 Kč</span>
                </div>
                <div
                  class="price-row cursor-default transition-transform duration-300 ease-in-out hover:scale-[1.02]"
                >
                  <button
                    type="button"
                    class="group relative cursor-help border-0 bg-transparent p-0 text-left font-[inherit] font-bold text-inherit"
                  >
                    Melír <span class="js-length-hint" data-full="(krátké / střední / dlouhé)" data-kratek="(krátké)" data-stredni="(střední)" data-dlouhe="(dlouhé)">(krátké / střední / dlouhé)</span><span
                      class="text-primary/50 material-symbols-outlined ml-1 align-middle text-[16px]"
                      >info</span
                    ><span
                      class="bg-surface-container-highest text-on-surface border-outline-variant/30 pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-64 -translate-x-1/2 rounded-xl border p-3 text-xs font-normal opacity-0 shadow-xl price-tooltip transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
                      >Zesvětlení nebo ztmavení vybraných pramenů vlasů pro
