    <script is:inline>
      // Scroll reveal
      const reveal = () => {
        const reveals = document.querySelectorAll(".reveal, .open-reveal");
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        reveals.forEach((el) => {
          if (reduceMotion) {
            el.classList.add("active");
            return;
          }

          const windowHeight = window.innerHeight;
          const elementTop = el.getBoundingClientRect().top;
          const elementVisible = 100;
          if (elementTop < windowHeight - elementVisible) {
            el.classList.add("active");
          }
        });
      };
      window.addEventListener("scroll", reveal);
      window.addEventListener("load", reveal);

      // Přepínání záložek ceníku (Dámy, Páni, Děti)
      window.switchTab = function (tabName) {
        document.querySelectorAll(".tab-btn").forEach((btn) => {
          const isActive = btn.id === "tab-" + tabName;
          btn.classList.toggle("active", isActive);
          btn.setAttribute("aria-selected", isActive ? "true" : "false");
          btn.tabIndex = isActive ? 0 : -1;
        });
        document.querySelectorAll(".tab-content").forEach((content) => {
          content.classList.toggle("hidden", content.id !== "content-" + tabName);
        });
      };

      const tabList = document.querySelector('[role="tablist"]');
      if (tabList) {
        tabList.addEventListener("keydown", (event) => {
          const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
          const currentIndex = tabs.indexOf(document.activeElement);
          if (currentIndex === -1) return;

          let nextIndex = null;
          if (event.key === "ArrowRight") {
            nextIndex = (currentIndex + 1) % tabs.length;
          } else if (event.key === "ArrowLeft") {
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          }
          if (nextIndex === null) return;

          event.preventDefault();
          const tabName = tabs[nextIndex].id.replace(/^tab-/, "");
          window.switchTab(tabName);
          tabs[nextIndex].focus();
        });
      }

      const hairGroup = document.querySelector('[aria-label="Délka vlasů"]');
      let selectedHairLength = null;

      function applyHairPrices() {
        const key = selectedHairLength || "full";
        document.querySelectorAll(".js-length-price").forEach((el) => {
          el.textContent = el.dataset[key] || el.dataset.full;
        });
        document.querySelectorAll(".js-length-hint").forEach((el) => {
          el.textContent = el.dataset[key] || el.dataset.full;
        });
      }

      window.selectHairLength = function (length) {
        selectedHairLength = length;
        document.querySelectorAll(".hair-option").forEach((btn) => {
          const isSelected = btn.dataset.hair === length;
          btn.setAttribute("aria-checked", isSelected ? "true" : "false");
        });
        applyHairPrices();
      };
      const tooltipTriggers = document.querySelectorAll(".tooltip-trigger");

      function placeTooltip(trigger) {
        const tip = trigger.querySelector(".price-tooltip");
        if (!tip) return;
        tip.style.transform = "translateX(-50%)";
        const rect = tip.getBoundingClientRect();
        const pad = 12;
        let shift = 0;
        if (rect.left < pad) shift += pad - rect.left;
        if (rect.right + shift > window.innerWidth - pad) {
          shift -= rect.right + shift - (window.innerWidth - pad);
        }
        tip.style.transform = `translateX(calc(-50% + ${shift}px))`;
      }

      function closeTooltips(except) {
        tooltipTriggers.forEach((btn) => {
          if (btn !== except) {
            btn.setAttribute("aria-expanded", "false");
            if (!except) btn.blur();
          }
        });
      }

      tooltipTriggers.forEach((btn) => {
        btn.setAttribute("aria-expanded", "false");
        const tip = btn.querySelector(".price-tooltip");
        if (tip) tip.setAttribute("role", "tooltip");

        btn.addEventListener("click", (event) => {
          event.stopPropagation();
          const isOpen = btn.getAttribute("aria-expanded") === "true";
          closeTooltips();
          if (!isOpen) {
            btn.setAttribute("aria-expanded", "true");
            placeTooltip(btn);
          }
        });
      });

      const navToggle = document.getElementById("nav-toggle");
      const mobileNav = document.getElementById("mobile-nav");
      const navToggleIcon = document.getElementById("nav-toggle-icon");
      const siteNav = document.querySelector("nav");

      function setMobileNav(open) {
        if (!navToggle || !mobileNav) return;
        mobileNav.classList.toggle("hidden", !open);
        navToggle.setAttribute("aria-expanded", open ? "true" : "false");
        navToggle.setAttribute(
          "aria-label",
          open ? "Zavřít menu" : "Otevřít menu",
        );
        if (navToggleIcon) navToggleIcon.textContent = open ? "close" : "menu";
      }

      if (navToggle && mobileNav) {
        navToggle.addEventListener("click", (event) => {
          event.stopPropagation();
          const isOpen = navToggle.getAttribute("aria-expanded") === "true";
          setMobileNav(!isOpen);
        });

        mobileNav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setMobileNav(false));
        });
      }

      document.addEventListener("click", (event) => {
        if (siteNav && !siteNav.contains(event.target)) {
          setMobileNav(false);
        }
        closeTooltips();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        closeTooltips();
        const menuOpen = navToggle?.getAttribute("aria-expanded") === "true";
        setMobileNav(false);
        if (menuOpen) navToggle.focus();
      });

      window.addEventListener("resize", () => {
        if (window.matchMedia("(min-width: 768px)").matches) {
          setMobileNav(false);
        }
        tooltipTriggers.forEach((btn) => {
          if (btn.getAttribute("aria-expanded") === "true") placeTooltip(btn);
        });
      });

      if (hairGroup) {
        hairGroup.addEventListener("keydown", (event) => {
          const options = Array.from(hairGroup.querySelectorAll(".hair-option"));
          const currentIndex = options.indexOf(document.activeElement);
          if (currentIndex === -1) return;

          let nextIndex = null;
          if (event.key === "ArrowRight") {
            nextIndex = (currentIndex + 1) % options.length;
          } else if (event.key === "ArrowLeft") {
            nextIndex = (currentIndex - 1 + options.length) % options.length;
          }
          if (nextIndex === null) return;

          event.preventDefault();
          const length = options[nextIndex].dataset.hair;
          window.selectHairLength(length);
          options[nextIndex].focus();
        });
      }
    </script>

    <script>
      const track = document.getElementById("gallery-track");
      const originalSlides = Array.from(
        document.querySelectorAll(".gallery-slide"),
      );

      const prevButton = document.getElementById("gallery-prev");
      const nextButton = document.getElementById("gallery-next");

      let currentIndex = 3;
      let isAnimating = false;

      // Duplikujeme první 3 a poslední 3 fotky
      const slidesPerView = 3;

      const firstClones = originalSlides
        .slice(0, slidesPerView)
        .map((slide) => slide.cloneNode(true));

      const lastClones = originalSlides
        .slice(-slidesPerView)
        .map((slide) => slide.cloneNode(true));

      // Přidáme kopie na začátek
      lastClones.reverse().forEach((slide) => {
        track.insertBefore(slide, track.firstChild);
      });

      // Přidáme kopie na konec
      firstClones.forEach((slide) => {
        track.appendChild(slide);
      });

      const slides = Array.from(track.querySelectorAll(".gallery-slide"));

      function updateCarousel(animate = true) {
        const slideWidth = slides[0].getBoundingClientRect().width;
        const gap = 24;

        track.style.transition = animate
          ? "transform 900ms ease-in-out"
          : "none";

        track.style.transform = `translateX(-${currentIndex * (slideWidth + gap)}px)`;
      }

      function goToNext() {
        if (isAnimating) return;

        isAnimating = true;
        currentIndex++;

        updateCarousel(true);
      }

      function goToPrev() {
        if (isAnimating) return;

        isAnimating = true;
        currentIndex--;

        updateCarousel(true);
      }

      nextButton.addEventListener("click", goToNext);
      prevButton.addEventListener("click", goToPrev);

      let touchStartX = 0;
      let touchStartY = 0;
      let touchMoved = false;

      track.addEventListener(
        "touchstart",
        (event) => {
          const touch = event.changedTouches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
          touchMoved = false;
          stopAutoplay();
        },
        { passive: true },
      );

      track.addEventListener(
        "touchmove",
        (event) => {
          const dx = event.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) > 10) touchMoved = true;
        },
        { passive: true },
      );

      track.addEventListener(
        "touchend",
        (event) => {
          const touch = event.changedTouches[0];
          const dx = touch.clientX - touchStartX;
          const dy = touch.clientY - touchStartY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            if (dx < 0) goToNext();
            else goToPrev();
          }
          startAutoplay();
        },
        { passive: true },
      );

      track.addEventListener("transitionend", () => {
        const originalLength = originalSlides.length;

        // Jsme za poslední skutečnou fotkou
        if (currentIndex >= originalLength + slidesPerView) {
          currentIndex = slidesPerView;

          updateCarousel(false);
        }

        // Jsme před první skutečnou fotkou
        if (currentIndex < slidesPerView) {
          currentIndex = originalLength + slidesPerView - 1;

          updateCarousel(false);
        }

        isAnimating = false;
      });

      window.addEventListener("resize", () => {
        updateCarousel(false);
      });

      // Začínáme na první skutečné fotce
      updateCarousel(false);

      // Automatické posouvání
      const carousel = document.getElementById("gallery-carousel");
      const autoplayDelay = 5000;
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      let autoplayTimer = null;

      function startAutoplay() {
        if (autoplayTimer || reducedMotion.matches || document.hidden) return;

        autoplayTimer = setInterval(goToNext, autoplayDelay);
      }

      function stopAutoplay() {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }

      carousel.addEventListener("mouseenter", stopAutoplay);
      carousel.addEventListener("mouseleave", startAutoplay);
      carousel.addEventListener("focusin", stopAutoplay);
      carousel.addEventListener("focusout", startAutoplay);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      });

      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      });

      startAutoplay();

      // Lightbox
      const lightbox = document.getElementById("gallery-lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxClose = document.getElementById("lightbox-close");
      let lastFocused = null;

      function openLightbox(image) {
        lastFocused = document.activeElement;
        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt;

        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        // Překreslení, aby se stihl spustit přechod krytí
        requestAnimationFrame(() => {
          lightbox.classList.remove("opacity-0");
        });

        document.body.style.overflow = "hidden";
        stopAutoplay();
        lightboxClose.focus();
      }

      function closeLightbox() {
        lightbox.classList.add("opacity-0");
        lightbox.classList.remove("flex");
        lightbox.classList.add("hidden");
        lightboxImage.src = "";
        lightboxImage.alt = "";

        document.body.style.overflow = "";
        startAutoplay();

        if (lastFocused) {
          lastFocused.focus();
          lastFocused = null;
        }
      }

      // Kliknutí na kteroukoli fotku v carouselu (včetně duplikovaných)
      track.addEventListener("click", (event) => {
        if (touchMoved) {
          touchMoved = false;
          return;
        }

        const trigger = event.target.closest(".gallery-trigger");
        if (!trigger) return;

        const image = trigger.querySelector("img");
        if (image) openLightbox(image);
      });

      lightboxClose.addEventListener("click", closeLightbox);

      // Kliknutí mimo fotografii
      lightbox.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !lightbox.classList.contains("hidden")) {
          closeLightbox();
        }
      });
    </script>

    <script>
      function setupCopyButton(buttonId, textId, value, idleLabel, copiedLabel) {
        const button = document.getElementById(buttonId);
        const label = document.getElementById(textId);
        if (!button || !label) return;

        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(value);
            label.textContent = copiedLabel;
            setTimeout(() => {
              label.textContent = idleLabel;
            }, 2000);
          } catch (error) {
            console.error("Nepodařilo se zkopírovat text:", error);
          }
        });
      }

      setupCopyButton(
        "copy-phone",
        "phone-copy-text",
        "604 172 884",
        "Zkopírovat číslo",
        "✓ Číslo zkopírováno",
      );

      const copyAddress = document.getElementById("copy-address");
      if (copyAddress) {
        const addressIcon = copyAddress.querySelector(".material-symbols-outlined");
        copyAddress.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText("Hliník 34, Bochoř");
            if (addressIcon) addressIcon.textContent = "check";
            copyAddress.setAttribute(
              "aria-label",
              "Adresa zkopírována: Hliník 34, Bochoř",
            );
            setTimeout(() => {
              if (addressIcon) addressIcon.textContent = "location_on";
              copyAddress.setAttribute(
                "aria-label",
                "Zkopírovat adresu Hliník 34, Bochoř",
              );
            }, 2000);
          } catch (error) {
            console.error("Nepodařilo se zkopírovat adresu:", error);
          }
        });
      }
    </script>
