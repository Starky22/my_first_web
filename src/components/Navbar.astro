---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import t from "../i18n/cs.json";
---

    <nav
      class="glass-nav border-outline-variant/20 px-3 sm:px-gutter fixed top-0 z-50 w-full border-b py-1 transition-all duration-300"
    >
      <div
        class="max-w-container-max mx-auto flex items-center justify-between gap-2"
      >
        <a
          class="font-headline-sm text-primary group flex min-w-0 flex-1 items-center gap-1.5 sm:gap-2 md:flex-none"
          href="#"
        >
          <Image
            src={logo}
            alt={t.navbar.logoAlt}
            loading="eager"
            decoding="async"
            class="h-14 w-14 shrink-0 scale-110 object-contain transition-transform group-hover:scale-125 sm:h-17 sm:w-17"
          />
          <span
            class="text-sm leading-tight tracking-tight sm:text-xl sm:whitespace-nowrap md:text-3xl"
            >{t.site.name}</span
          >
        </a>
        <div
          class="font-Inter hidden items-center gap-8 tracking-wider uppercase md:flex"
        >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#o-nas">{t.navbar.about}</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#sluzby">{t.navbar.pricing}</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#galerie">{t.navbar.gallery}</a
          >
          <a
            class="text-on-surface-variant hover:text-primary transition-colors"
            href="#kontakt">{t.navbar.contact}</a
          >
        </div>
        <div class="flex shrink-0 items-center gap-1 sm:gap-2">
          <a
            class="bg-primary text-on-primary font-Inter hover:bg-primary/90 inline-flex min-h-11 items-center rounded-full px-3 py-2 text-xs shadow-md transition-all sm:px-4 sm:text-sm md:px-6 md:text-base"
            href="#kontakt"
          >
            {t.navbar.reservation}
          </a>
          <button
            type="button"
            id="nav-toggle"
            class="text-primary hover:bg-primary/10 inline-flex h-11 w-11 items-center justify-center rounded-full md:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label={t.navbar.openMenu}
            data-open-label={t.navbar.openMenu}
            data-close-label={t.navbar.closeMenu}
          >
            <span class="material-symbols-outlined" id="nav-toggle-icon"
              >menu</span
            >
          </button>
        </div>
      </div>
      <div id="mobile-nav" class="border-outline-variant/20 hidden border-t md:hidden">
        <div
          class="font-Inter flex flex-col gap-1 py-3 tracking-wider uppercase"
        >
          <a
            class="text-on-surface-variant hover:text-primary flex min-h-11 items-center transition-colors"
            href="#o-nas">{t.navbar.about}</a
          >
          <a
            class="text-on-surface-variant hover:text-primary flex min-h-11 items-center transition-colors"
            href="#sluzby">{t.navbar.pricing}</a
          >
          <a
            class="text-on-surface-variant hover:text-primary flex min-h-11 items-center transition-colors"
            href="#galerie">{t.navbar.gallery}</a
          >
          <a
            class="text-on-surface-variant hover:text-primary flex min-h-11 items-center transition-colors"
            href="#kontakt">{t.navbar.contact}</a
          >
        </div>
      </div>
    </nav>

    <script>
      const navToggle = document.getElementById("nav-toggle");
      const mobileNav = document.getElementById("mobile-nav");
      const navToggleIcon = document.getElementById("nav-toggle-icon");
      const siteNav = navToggle?.closest("nav");

      if (navToggle && mobileNav && siteNav && !siteNav.dataset.ready) {
        siteNav.dataset.ready = "true";

        function setMobileNav(open) {
          mobileNav.classList.toggle("hidden", !open);
          navToggle.setAttribute("aria-expanded", open ? "true" : "false");
          navToggle.setAttribute(
            "aria-label",
            open ? navToggle.dataset.closeLabel : navToggle.dataset.openLabel,
          );
          if (navToggleIcon) navToggleIcon.textContent = open ? "close" : "menu";
        }

        navToggle.addEventListener("click", (event) => {
          event.stopPropagation();
          const isOpen = navToggle.getAttribute("aria-expanded") === "true";
          setMobileNav(!isOpen);
        });

        mobileNav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setMobileNav(false));
        });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Node) || !siteNav.contains(event.target)) {
            setMobileNav(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          const menuOpen = navToggle.getAttribute("aria-expanded") === "true";
          setMobileNav(false);
          if (menuOpen) navToggle.focus();
        });

        window.addEventListener("resize", () => {
          if (window.matchMedia("(min-width: 768px)").matches) {
            setMobileNav(false);
          }
        });
      }
    </script>
