---
import t from "../i18n/cs.json";
---

    <footer class="bg-surface-container-highest py-stack-md">
      <div class="max-w-container-max px-gutter mx-auto">
        <div
          class="mb-12 flex flex-col items-center justify-between gap-8 md:flex-row"
        >
          <div class="text-center md:text-left">
            <a
              class="font-Inter text-primary flex items-center justify-center gap-2 md:justify-start"
              href="#"
            >
              <img
                alt={t.footer.logoAlt}
                class="h-17 w-17 scale-110 object-contain opacity-70"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuB1pYNkVrumGXcnG3Kms4rFIhsT5kG6saj7xoUtZ63DrJjAv5G4hMklzhM-FdvH-nPSCr6hnLcUsIUtqe379i5Q_mJbewCsJPswSdtFvLt1WXZ068eVZLqM0gDgwz94XGCoAwM-y8OXiUwrR28V2YmInJlJGL5xNHZr6BwYttHBjTfipW8egmPyLLQUsGlndOvGaNtKPnImzoKALFtVtLIENmcDjin1TTgCyyYtXSL4oO9M7ikSELh5bWQd_zEwFvg2VQ"
              />
              <span class="font-Inter text-xl tracking-tight"
                >{t.site.name}</span
              >
            </a>
            <p class="font-Inter mt-2 opacity-60">
              {t.footer.tagline}
            </p>
          </div>
          <div class="flex items-center gap-4 opacity-70">
            <a
              aria-label={t.footer.instagramAria}
              class="text-primary inline-flex h-11 w-11 items-center justify-center transition-transform hover:scale-110"
              href="https://www.instagram.com/pe_tra2514?dlrf=dmV5a3lrazZrczg2"
              target="_blank"
              rel="noopener noreferrer"
              ><svg
                fill="none"
                height="30"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="30"
                xmlns="http://www.w3.org/2000/svg"
                ><rect height="20" rx="5" ry="5" width="20" x="2" y="2"
                ></rect><path
                  d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                ></line></svg
              ></a
            >
            <a
              aria-label={t.footer.facebookAria}
              class="text-primary inline-flex h-11 w-11 items-center justify-center transition-transform hover:scale-110"
              href="https://www.facebook.com/petra.kavkova.3?locale=cs_CZ"
              target="_blank"
              rel="noopener noreferrer"
              ><svg
                fill="none"
                height="30"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="30"
                xmlns="http://www.w3.org/2000/svg"
                ><path
                  d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                ></path></svg
              ></a
            >
          </div>
        </div>
        <div
          class="border-outline-variant/20 text-Inter border-t pt-1 text-center opacity-40"
        >
          {t.footer.copyright}
        </div>
      </div>
    </footer>
