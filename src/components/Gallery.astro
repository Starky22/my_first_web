---
import t from "../i18n/cs.json";
---

    <section
      class="py-stack-lg px-gutter max-w-container-max mx-auto"
      id="galerie"
    >
      <div class="reveal active mb-16 text-center">
        <span
          class="text-primary font-Inter mb-4 block tracking-[0.2em] uppercase"
        >
          {t.gallery.eyebrow}
        </span>
        <h2 class="font-Inter text-on-surface text-2xl">{t.gallery.title}</h2>
      </div>

      <!-- Carousel -->
      <div class="relative" id="gallery-carousel">
        <!-- Left arrow -->
        <button
          id="gallery-prev"
          type="button"
          aria-label={t.gallery.previous}
          class="text-on-surface hover:bg-primary absolute top-1/2 left-2 z-30 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-md transition-all duration-300 hover:text-white touch-manipulation md:left-0 md:-translate-x-1/2"
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><line x1="19" x2="5" y1="12" y2="12"></line><polyline
              points="12 19 5 12 12 5"></polyline></svg
          >
        </button>

        <!-- Viewport -->
        <div class="touch-manipulation overflow-hidden px-1" id="gallery-viewport">
          <div
            id="gallery-track"
            class="flex gap-6 transition-transform duration-500 ease-in-out"
          >
            <!-- Photo 1 -->
            <div
              class="gallery-slide w-full flex-shrink-0 md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]"
            >
              <button
                type="button"
                aria-label={`${t.gallery.zoomPhoto}: ${t.gallery.photos[0]}`}
                class="gallery-trigger group relative block w-full cursor-zoom-in overflow-hidden rounded-xl border-0 bg-transparent p-0"
              >
                <img
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCVrUypYXNOcXD19NdhKRM2YPCftq5m5q0fKlTNzllmFAbZHAJtCaYehT8b6i62hmNBurgnDu4u0cqmsEqYFObUU2Tr2anWsJmbKDsHWAc-0d7yqiOUP00jQGpjbeohO2QMod4pkYpJZaf-bpIqmKVAXAgNQzy_-cxLPCggR7ychdvdjDIf-ujk7j8We7gpJFEvN5D1q6acBc6CbBlVSu6uTPUo6JYFC8T21lcwjt-kieNIBveSUsl5yyl8rk4BwnY-aPE=w945"
                  alt={t.gallery.photos[0]}
                  loading="lazy"
                  decoding="async"
                  class="pointer-events-none aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </button>
            </div>

            <!-- Photo 2 -->
            <div
              class="gallery-slide w-full flex-shrink-0 md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]"
            >
              <button
                type="button"
                aria-label={`${t.gallery.zoomPhoto}: ${t.gallery.photos[1]}`}
                class="gallery-trigger group relative block w-full cursor-zoom-in overflow-hidden rounded-xl border-0 bg-transparent p-0"
              >
                <img
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBRwAiCaim7lXHsTzVeDrDttssC0NlONFVCIR5Vp6xLbpUCIQEBueW9GcVPEaT1Tmr-bEon4nj9KJoZJOXc22zdRQzD2Qe9dlqZeZ-tbZKxnvXWi1GI5Dzm2-IIZadXbN1dmNfrTi8O5ihDtMQUC4hbhJjlgSLNpWsGncbNN_eDeBLKcP5UQmeudYXv4mTvQJiyTeYOp9m_cLyeRYZtk64klpcVM4NRIK0wBFbfMmOBDeppaQnNeZoKT8CYzqAYya-eMy8=w945"
                  alt={t.gallery.photos[1]}
                  loading="lazy"
                  decoding="async"
                  class="pointer-events-none aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </button>
            </div>

            <!-- Photo 3 -->
            <div
              class="gallery-slide w-full flex-shrink-0 md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]"
            >
              <button
                type="button"
                aria-label={`${t.gallery.zoomPhoto}: ${t.gallery.photos[2]}`}
                class="gallery-trigger group relative block w-full cursor-zoom-in overflow-hidden rounded-xl border-0 bg-transparent p-0"
              >
                <img
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBWsvhcPI2a3DydZ0t2-l_tREwYFHpt4NFSzd5ELUBOvJrvsrWQSmCFCptNqe32AOw8tr1HIip3tyAWhc11s8Nq8IFU-bwVVna5MYOYoYj2tTkPfD4TsdRL2VhDkqEOyMH2aZ2e_sKjVOWlKqwEg5_zcRKM77gl2y7hxeYX9fc092HmKWqgAfDeXeKOQSuFskPL5RrTafFm58uWTlYWusyRuopWbILtzsB4b3SuDzV4lDym2CsKUmyv8Oc3znG3UCZEel0=w945"
                  alt={t.gallery.photos[2]}
                  loading="lazy"
                  decoding="async"
                  class="pointer-events-none aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </button>
            </div>

            <!-- Photo 4 -->
            <div
              class="gallery-slide w-full flex-shrink-0 md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]"
            >
              <button
                type="button"
                aria-label={`${t.gallery.zoomPhoto}: ${t.gallery.photos[3]}`}
                class="gallery-trigger group relative block w-full cursor-zoom-in overflow-hidden rounded-xl border-0 bg-transparent p-0"
              >
                <img
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuAWBw4PxsFHgp8_ruenvL7_lsyXaLIMXN9fQpieda3P6n_Fd74tKcKgYed-CrAm2SzmT8iCaI2RxQjTK4qf82tDT1keN3TjXw82LwG8cg_NlunwFNiXFPCAtlq1AYkmstICdbhWBlmXtY7-E40pBzOS2RAkNZm09NpD6KFG4Kij4NrDfwBIilagEd5br2jEsv6yoaEEXwPyJYhkYYvAUzq4vBX5OPkm-slu1_v2AwOJCDrAWC1nn0_-W2XYI2WkXtmyGjw=w945"
                  alt={t.gallery.photos[3]}
                  loading="lazy"
                  decoding="async"
                  class="pointer-events-none aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </button>
            </div>
          </div>
        </div>

        <!-- Right arrow -->
        <button
          id="gallery-next"
          type="button"
          aria-label={t.gallery.next}
          class="text-on-surface hover:bg-primary absolute top-1/2 right-2 z-30 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-md transition-all duration-300 hover:text-white touch-manipulation md:right-0 md:translate-x-1/2"
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><line x1="5" x2="19" y1="12" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </button>
      </div>

      <!-- Lightbox -->
      <div
        id="gallery-lightbox"
        role="dialog"
        aria-modal="true"
        aria-label={t.gallery.lightbox}
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 opacity-0 transition-opacity duration-300 sm:p-8"
      >
        <button
          id="lightbox-close"
          type="button"
          aria-label={t.gallery.close}
          class="text-on-surface hover:bg-primary absolute top-4 right-4 z-10 flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-2xl leading-none shadow-md transition-all duration-300 hover:text-white sm:top-6 sm:right-6"
        >
          ×
        </button>
        <img
          id="lightbox-image"
          src=""
          alt=""
          class="max-h-full max-w-full rounded-xl object-contain shadow-2xl"
        />
      </div>
    </section>

    <script>
      const track = document.getElementById("gallery-track");
      const viewport = document.getElementById("gallery-viewport");
      const prevButton = document.getElementById("gallery-prev");
      const nextButton = document.getElementById("gallery-next");
      const carousel = document.getElementById("gallery-carousel");
      const lightbox = document.getElementById("gallery-lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxClose = document.getElementById("lightbox-close");

      if (
        !track ||
        !viewport ||
        !prevButton ||
        !nextButton ||
        !carousel ||
        !lightbox ||
        !(lightboxImage instanceof HTMLImageElement) ||
        !lightboxClose
      ) {
        // Gallery is not on the page
      } else if (!track.dataset.ready) {
        setupGallery(
          track,
          viewport,
          prevButton,
          nextButton,
          carousel,
          lightbox,
          lightboxImage,
          lightboxClose,
        );
      }

      function setupGallery(
        track: HTMLElement,
        viewport: HTMLElement,
        prevButton: HTMLElement,
        nextButton: HTMLElement,
        carousel: HTMLElement,
        lightbox: HTMLElement,
        lightboxImage: HTMLImageElement,
        lightboxClose: HTMLElement,
      ) {
        track.dataset.ready = "true";

        const originalSlides = Array.from(
          track.querySelectorAll(".gallery-slide"),
        );

        let currentIndex = 3;
        let isAnimating = false;
        let animationReset = 0;

        // Clone the first 3 and last 3 photos
        const slidesPerView = 3;

        const firstClones = originalSlides
          .slice(0, slidesPerView)
          .map((slide) => slide.cloneNode(true));

        const lastClones = originalSlides
          .slice(-slidesPerView)
          .map((slide) => slide.cloneNode(true));

        // Insert clones at the start
        lastClones.reverse().forEach((slide) => {
          if (!track) return;
          track.insertBefore(slide, track.firstChild);
        });

        // Append clones at the end
        firstClones.forEach((slide) => {
          if (!track) return;
          track.appendChild(slide);
        });

        const slides = Array.from(track.querySelectorAll(".gallery-slide"));

        function getSlideWidth() {
          return slides[0]?.getBoundingClientRect().width || 0;
        }

        function updateCarousel(animate = true) {
          if (!track) return;

          const slideWidth = getSlideWidth();
          if (!slideWidth) return;

          const gap = 24;

          track.style.transition = animate
            ? "transform 900ms ease-in-out"
            : "none";

          track.style.transform = `translateX(-${currentIndex * (slideWidth + gap)}px)`;
        }

        function finishAnimation() {
          const originalLength = originalSlides.length;

          // Past the last real photo
          if (currentIndex >= originalLength + slidesPerView) {
            currentIndex = slidesPerView;
            updateCarousel(false);
          }

          // Before the first real photo
          if (currentIndex < slidesPerView) {
            currentIndex = originalLength + slidesPerView - 1;
            updateCarousel(false);
          }

          isAnimating = false;
        }

        function goToNext() {
          if (isAnimating || !getSlideWidth()) return;

          isAnimating = true;
          currentIndex++;
          updateCarousel(true);
          window.clearTimeout(animationReset);
          animationReset = window.setTimeout(finishAnimation, 1000);
        }

        function goToPrev() {
          if (isAnimating || !getSlideWidth()) return;

          isAnimating = true;
          currentIndex--;
          updateCarousel(true);
          window.clearTimeout(animationReset);
          animationReset = window.setTimeout(finishAnimation, 1000);
        }

        nextButton.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          goToNext();
        });
        prevButton.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          goToPrev();
        });

        let pointerStartX = 0;
        let pointerStartY = 0;
        let pointerActive = false;
        let pointerSwiped = false;

        viewport.addEventListener("pointerdown", (event) => {
          if (!(event.target instanceof Element)) return;
          if (event.target.closest("#gallery-prev, #gallery-next")) return;
          if (event.pointerType === "mouse" && event.button !== 0) return;

          pointerActive = true;
          pointerSwiped = false;
          pointerStartX = event.clientX;
          pointerStartY = event.clientY;
          stopAutoplay();
        });

        viewport.addEventListener(
          "pointermove",
          (event) => {
            if (!pointerActive) return;

            const dx = event.clientX - pointerStartX;
            const dy = event.clientY - pointerStartY;

            if (Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) {
              pointerSwiped = true;
              if (event.cancelable) event.preventDefault();
            }
          },
          { passive: false },
        );

        function endPointerSwipe(event: PointerEvent) {
          if (!pointerActive) return;
          pointerActive = false;

          const dx = event.clientX - pointerStartX;
          const dy = event.clientY - pointerStartY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            pointerSwiped = true;
            if (dx < 0) goToNext();
            else goToPrev();
          }

          startAutoplay();
        }

        viewport.addEventListener("pointerup", endPointerSwipe);
        viewport.addEventListener("pointercancel", endPointerSwipe);

        track.addEventListener("transitionend", (event) => {
          if (event.target !== track || event.propertyName !== "transform") return;
          window.clearTimeout(animationReset);
          finishAnimation();
        });

        window.addEventListener("resize", () => {
          updateCarousel(false);
        });

        // Start on the first real photo
        updateCarousel(false);
        requestAnimationFrame(() => updateCarousel(false));
        window.addEventListener("load", () => updateCarousel(false));

        // Autoplay
        const autoplayDelay = 5000;
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        let autoplayTimer: ReturnType<typeof setInterval> | null = null;

        function startAutoplay() {
          if (autoplayTimer || reducedMotion.matches || document.hidden) return;

          autoplayTimer = setInterval(goToNext, autoplayDelay);
        }

        function stopAutoplay() {
          if (autoplayTimer) {
            clearInterval(autoplayTimer);
            autoplayTimer = null;
          }
        }

        carousel.addEventListener("mouseenter", stopAutoplay);
        carousel.addEventListener("mouseleave", startAutoplay);
        carousel.addEventListener("focusin", stopAutoplay);
        carousel.addEventListener("focusout", startAutoplay);

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            stopAutoplay();
          } else {
            startAutoplay();
          }
        });

        reducedMotion.addEventListener("change", () => {
          if (reducedMotion.matches) {
            stopAutoplay();
          } else {
            startAutoplay();
          }
        });

        startAutoplay();

        let lastFocused: HTMLElement | null = null;

        function openLightbox(image: HTMLImageElement) {
          lastFocused =
            document.activeElement instanceof HTMLElement
              ? document.activeElement
              : null;
          lightboxImage.src = image.currentSrc || image.src;
          lightboxImage.alt = image.alt;

          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
          // Force a repaint so the opacity transition can run
          requestAnimationFrame(() => {
            lightbox.classList.remove("opacity-0");
          });

          document.body.style.overflow = "hidden";
          stopAutoplay();
          lightboxClose.focus();
        }

        function closeLightbox() {
          lightbox.classList.add("opacity-0");
          lightbox.classList.remove("flex");
          lightbox.classList.add("hidden");
          lightboxImage.src = "";
          lightboxImage.alt = "";

          document.body.style.overflow = "";
          startAutoplay();

          if (lastFocused) {
            lastFocused.focus();
            lastFocused = null;
          }
        }

        // Click on any carousel photo, including clones
        track.addEventListener("click", (event) => {
          if (pointerSwiped) {
            pointerSwiped = false;
            event.preventDefault();
            return;
          }

          if (!(event.target instanceof Element)) return;

          const trigger = event.target.closest(".gallery-trigger");
          if (!trigger) return;

          const image = trigger.querySelector("img");
          if (image) openLightbox(image);
        });

        lightboxClose.addEventListener("click", closeLightbox);

        // Click outside the photo
        lightbox.addEventListener("click", (event) => {
          if (event.target === lightbox) closeLightbox();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !lightbox.classList.contains("hidden")) {
            closeLightbox();
          }
        });
      }
    </script>
