    <script>
      const pricing = document.getElementById("sluzby");

      if (pricing && !pricing.dataset.ready) {
        pricing.dataset.ready = "true";

        const tabList = pricing.querySelector('[role="tablist"]');
        const hairGroup = pricing.querySelector('[role="radiogroup"]');
        const tooltipTriggers = pricing.querySelectorAll(".tooltip-trigger");
        let selectedHairLength = null;

        function switchTab(tabName) {
          pricing.querySelectorAll(".tab-btn").forEach((btn) => {
            const isActive = btn.dataset.tab === tabName;
            btn.classList.toggle("active", isActive);
            btn.setAttribute("aria-selected", isActive ? "true" : "false");
            btn.tabIndex = isActive ? 0 : -1;
          });
          pricing.querySelectorAll(".tab-content").forEach((content) => {
            content.classList.toggle("hidden", content.id !== "content-" + tabName);
          });
        }

        function applyHairPrices() {
          const key = selectedHairLength || "full";
          pricing.querySelectorAll(".js-length-price").forEach((el) => {
            el.textContent = el.dataset[key] || el.dataset.full;
          });
          pricing.querySelectorAll(".js-length-hint").forEach((el) => {
            el.textContent = el.dataset[key] || el.dataset.full;
          });
        }

        function selectHairLength(length) {
          selectedHairLength = length;
          pricing.querySelectorAll(".hair-option").forEach((btn) => {
            const isSelected = btn.dataset.hair === length;
            btn.setAttribute("aria-checked", isSelected ? "true" : "false");
          });
          applyHairPrices();
        }

        function placeTooltip(trigger) {
          const tip = trigger.querySelector(".price-tooltip");
          if (!tip) return;
          tip.style.transform = "translateX(-50%)";
          const rect = tip.getBoundingClientRect();
          const pad = 12;
          let shift = 0;
          if (rect.left < pad) shift += pad - rect.left;
          if (rect.right + shift > window.innerWidth - pad) {
            shift -= rect.right + shift - (window.innerWidth - pad);
          }
          tip.style.transform = `translateX(calc(-50% + ${shift}px))`;
        }

        function closeTooltips(except) {
          tooltipTriggers.forEach((btn) => {
            if (btn !== except) {
              btn.setAttribute("aria-expanded", "false");
              if (!except) btn.blur();
            }
          });
        }

        pricing.querySelectorAll(".tab-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            if (btn.dataset.tab) switchTab(btn.dataset.tab);
          });
        });

        pricing.querySelectorAll(".hair-option").forEach((btn) => {
          btn.addEventListener("click", () => {
            if (btn.dataset.hair) selectHairLength(btn.dataset.hair);
          });
        });

        if (tabList) {
          tabList.addEventListener("keydown", (event) => {
            const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
            const currentIndex = tabs.indexOf(document.activeElement);
            if (currentIndex === -1) return;

            let nextIndex = null;
            if (event.key === "ArrowRight") {
              nextIndex = (currentIndex + 1) % tabs.length;
            } else if (event.key === "ArrowLeft") {
              nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
            }
            if (nextIndex === null) return;

            event.preventDefault();
            const tabName = tabs[nextIndex].dataset.tab;
            if (tabName) switchTab(tabName);
            tabs[nextIndex].focus();
          });
        }

        if (hairGroup) {
          hairGroup.addEventListener("keydown", (event) => {
            const options = Array.from(hairGroup.querySelectorAll(".hair-option"));
            const currentIndex = options.indexOf(document.activeElement);
            if (currentIndex === -1) return;

            let nextIndex = null;
            if (event.key === "ArrowRight") {
              nextIndex = (currentIndex + 1) % options.length;
            } else if (event.key === "ArrowLeft") {
              nextIndex = (currentIndex - 1 + options.length) % options.length;
            }
            if (nextIndex === null) return;

            event.preventDefault();
            const length = options[nextIndex].dataset.hair;
            if (length) selectHairLength(length);
            options[nextIndex].focus();
          });
        }

        tooltipTriggers.forEach((btn) => {
          btn.setAttribute("aria-expanded", "false");
          const tip = btn.querySelector(".price-tooltip");
          if (tip) tip.setAttribute("role", "tooltip");

          btn.addEventListener("click", (event) => {
            event.stopPropagation();
            const isOpen = btn.getAttribute("aria-expanded") === "true";
            closeTooltips();
            if (!isOpen) {
              btn.setAttribute("aria-expanded", "true");
              placeTooltip(btn);
            }
          });
        });

        document.addEventListener("click", () => {
          closeTooltips();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeTooltips();
        });

        window.addEventListener("resize", () => {
          tooltipTriggers.forEach((btn) => {
            if (btn.getAttribute("aria-expanded") === "true") placeTooltip(btn);
          });
        });
      }
    </script>
