---
import { Image } from "astro:assets";
import hairLength from "../assets/images/hair-length.png";
import { children, men, women } from "../data/pricing";
import PriceRow from "./PriceRow.astro";
import t from "../i18n/cs.json";
---

<section class="py-stack-lg bg-surface-container-low" id="sluzby">
  <div class="max-w-container-max px-gutter mx-auto">
    <div class="reveal mb-16 text-center">
      <span
        class="text-primary font-Inter mb-4 block tracking-[0.2em] uppercase"
        >{t.pricing.eyebrow}</span
      >
      <h2 class="font-Inter text-on-surface text-3xl">
        {t.pricing.title}
      </h2>
    </div>

    <div
      class="mb-12"
      role="radiogroup"
      aria-label={t.pricing.hairLengthAria}
      aria-labelledby="hair-length-heading"
    >
      <div class="mb-6 text-center md:mb-8">
        <h3
          id="hair-length-heading"
          class="font-Inter text-on-surface mb-3 text-xl md:text-2xl"
        >
          {t.pricing.hairLengthTitle}
        </h3>
        <p
          class="font-Inter text-on-surface-variant mx-auto max-w-xl text-sm leading-relaxed md:text-base"
        >
          {t.pricing.hairLengthDescription}
        </p>
      </div>
      <div
        class="mx-auto grid w-full max-w-md grid-cols-3 gap-2 sm:max-w-lg sm:gap-3 md:max-w-xl"
      >
        <button
          type="button"
          role="radio"
          aria-checked="false"
          aria-label={t.pricing.shortHair}
          data-hair="kratek"
          class="hair-option overflow-hidden rounded-2xl bg-white shadow-sm"
        >
          <span class="relative block aspect-[3/4] overflow-hidden">
            <Image
              src={hairLength}
              alt=""
              loading="lazy"
              class="absolute inset-y-0 left-0 h-full w-[300%] max-w-none object-cover"
            />
          </span>
          <span
            class="font-Inter text-on-surface block px-1 py-2 text-center text-xs leading-tight font-medium sm:text-sm"
            >{t.pricing.shortHair}</span
          >
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          aria-label={t.pricing.mediumHair}
          data-hair="stredni"
          class="hair-option overflow-hidden rounded-2xl bg-white shadow-sm"
        >
          <span class="relative block aspect-[3/4] overflow-hidden">
            <Image
              src={hairLength}
              alt=""
              loading="lazy"
              class="absolute inset-y-0 left-[-100%] h-full w-[300%] max-w-none object-cover"
            />
          </span>
          <span
            class="font-Inter text-on-surface block px-1 py-2 text-center text-xs leading-tight font-medium sm:text-sm"
            >{t.pricing.mediumHair}</span
          >
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          aria-label={t.pricing.longHair}
          data-hair="dlouhe"
          class="hair-option overflow-hidden rounded-2xl bg-white shadow-sm"
        >
          <span class="relative block aspect-[3/4] overflow-hidden">
            <Image
              src={hairLength}
              alt=""
              loading="lazy"
              class="absolute inset-y-0 left-[-200%] h-full w-[300%] max-w-none object-cover"
            />
          </span>
          <span
            class="font-Inter text-on-surface block px-1 py-2 text-center text-xs leading-tight font-medium sm:text-sm"
            >{t.pricing.longHair}</span
          >
        </button>
      </div>
    </div>

    <div class="reveal mb-12 flex justify-center">
      <div
        class="border-outline-variant/30 inline-flex max-w-full rounded-full border bg-white/50 p-1"
        role="tablist"
        aria-label={t.pricing.categoryAria}
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="content-damy"
          tabindex="0"
          class="tab-btn font-Inter active min-h-11 rounded-full px-4 py-2 tracking-widest uppercase transition-all sm:px-8"
          id="tab-damy"
          data-tab="damy">{t.pricing.tabLadies}</button
        >
        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="content-pani"
          tabindex="-1"
          class="tab-btn font-Inter min-h-11 rounded-full px-4 py-2 tracking-widest uppercase transition-all sm:px-8"
          id="tab-pani"
          data-tab="pani">{t.pricing.tabGentlemen}</button
        >
        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="content-deti"
          tabindex="-1"
          class="tab-btn font-Inter min-h-11 rounded-full px-4 py-2 tracking-widest uppercase transition-all sm:px-8"
          id="tab-deti"
          data-tab="deti">{t.pricing.tabChildren}</button
        >
      </div>
    </div>

    <div class="mx-auto max-w-5xl">
      <div
        class="tab-content flex flex-col gap-12"
        id="content-damy"
        role="tabpanel"
        aria-labelledby="tab-damy"
      >
        {
          women.groups.map((group) => (
            <div class="reveal">
              <h3 class="font-Inter text-primary border-primary/20 mb-6 border-b pb-2 text-2xl">
                {group.title}
              </h3>
              <div class="space-y-4">
                {group.items.map((item) => (
                  <PriceRow item={item} />
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div
        class="tab-content hidden space-y-8"
        id="content-pani"
        role="tabpanel"
        aria-labelledby="tab-pani"
      >
        {
          men.groups.map((group) => (
            <div class="reveal">
              <h3 class="font-Inter text-primary border-primary/20 mb-6 border-b pb-2 text-2xl">
                {group.title}
              </h3>
              <div class="space-y-4">
                {group.items.map((item) => (
                  <PriceRow item={item} />
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div
        class="tab-content hidden space-y-8"
        id="content-deti"
        role="tabpanel"
        aria-labelledby="tab-deti"
      >
        {
          children.groups.map((group) => (
            <div class="reveal">
              <h3 class="font-Inter text-primary border-primary/20 mb-6 border-b pb-2 text-2xl">
                {group.title}
              </h3>
              <div class="space-y-4">
                {group.items.map((item) => (
                  <PriceRow item={item} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="reveal mt-16 text-center">
      <p class="text-on-surface-variant font-Inter mb-6 italic">
        {t.pricing.disclaimer}
      </p>
    </div>
  </div>
</section>

<script>
  const pricing = document.getElementById("sluzby");

  if (pricing && !pricing.dataset.ready) {
    const root = pricing;
    root.dataset.ready = "true";

    const tabList = root.querySelector<HTMLElement>('[role="tablist"]');
    const hairGroup = root.querySelector<HTMLElement>('[role="radiogroup"]');
    const tooltipTriggers =
      root.querySelectorAll<HTMLElement>(".tooltip-trigger");
    let selectedHairLength: string | null = null;

    function switchTab(tabName: string) {
      root.querySelectorAll<HTMLElement>(".tab-btn").forEach((btn) => {
        const isActive = btn.dataset.tab === tabName;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
        btn.tabIndex = isActive ? 0 : -1;
      });
      root.querySelectorAll<HTMLElement>(".tab-content").forEach((content) => {
        content.classList.toggle("hidden", content.id !== "content-" + tabName);
      });
    }

    function applyHairPrices() {
      const key = selectedHairLength || "full";
      root.querySelectorAll<HTMLElement>(".js-length-price").forEach((el) => {
        el.textContent = el.dataset[key] || el.dataset.full || "";
      });
      root.querySelectorAll<HTMLElement>(".js-length-hint").forEach((el) => {
        el.textContent = el.dataset[key] || el.dataset.full || "";
      });
    }

    function selectHairLength(length: string) {
      selectedHairLength = length;
      root.querySelectorAll<HTMLElement>(".hair-option").forEach((btn) => {
        const isSelected = btn.dataset.hair === length;
        btn.setAttribute("aria-checked", isSelected ? "true" : "false");
      });
      applyHairPrices();
    }

    function placeTooltip(trigger: HTMLElement) {
      const tip = trigger.querySelector<HTMLElement>(".price-tooltip");
      if (!tip) return;
      tip.style.transform = "translateX(-50%)";
      const rect = tip.getBoundingClientRect();
      const pad = 12;
      let shift = 0;
      if (rect.left < pad) shift += pad - rect.left;
      if (rect.right + shift > window.innerWidth - pad) {
        shift -= rect.right + shift - (window.innerWidth - pad);
      }
      tip.style.transform = `translateX(calc(-50% + ${shift}px))`;
    }

    function closeTooltips(except?: HTMLElement) {
      tooltipTriggers.forEach((btn) => {
        if (btn !== except) {
          btn.setAttribute("aria-expanded", "false");
          if (!except) btn.blur();
        }
      });
    }

    root.querySelectorAll<HTMLElement>(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.tab) switchTab(btn.dataset.tab);
      });
    });

    root.querySelectorAll<HTMLElement>(".hair-option").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.hair) selectHairLength(btn.dataset.hair);
      });
    });

    if (tabList) {
      tabList.addEventListener("keydown", (event: KeyboardEvent) => {
        const tabs = Array.from(
          tabList.querySelectorAll<HTMLElement>('[role="tab"]'),
        );
        const currentIndex = tabs.indexOf(
          document.activeElement as HTMLElement,
        );
        if (currentIndex === -1) return;

        let nextIndex: number | null = null;
        if (event.key === "ArrowRight") {
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (event.key === "ArrowLeft") {
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        }
        if (nextIndex === null) return;

        event.preventDefault();
        const tabName = tabs[nextIndex].dataset.tab;
        if (tabName) switchTab(tabName);
        tabs[nextIndex].focus();
      });
    }

    if (hairGroup) {
      hairGroup.addEventListener("keydown", (event: KeyboardEvent) => {
        const options = Array.from(
          hairGroup.querySelectorAll<HTMLElement>(".hair-option"),
        );
        const currentIndex = options.indexOf(
          document.activeElement as HTMLElement,
        );
        if (currentIndex === -1) return;

        let nextIndex: number | null = null;
        if (event.key === "ArrowRight") {
          nextIndex = (currentIndex + 1) % options.length;
        } else if (event.key === "ArrowLeft") {
          nextIndex = (currentIndex - 1 + options.length) % options.length;
        }
        if (nextIndex === null) return;

        event.preventDefault();
        const length = options[nextIndex].dataset.hair;
        if (length) selectHairLength(length);
        options[nextIndex].focus();
      });
    }

    tooltipTriggers.forEach((btn) => {
      btn.setAttribute("aria-expanded", "false");
      const tip = btn.querySelector(".price-tooltip");
      if (tip) tip.setAttribute("role", "tooltip");

      btn.addEventListener("click", (event) => {
        event.stopPropagation();
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        closeTooltips();
        if (!isOpen) {
          btn.setAttribute("aria-expanded", "true");
          placeTooltip(btn);
        }
      });
    });

    document.addEventListener("click", () => {
      closeTooltips();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeTooltips();
    });

    window.addEventListener("resize", () => {
      tooltipTriggers.forEach((btn) => {
        if (btn.getAttribute("aria-expanded") === "true") placeTooltip(btn);
      });
    });
  }
</script>
