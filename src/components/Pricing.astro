                  >
                    {items.curling.name} <span class="js-length-hint" data-full={curlHint.full} data-kratek={curlHint.short} data-stredni={curlHint.medium} data-dlouhe={curlHint.long}>{curlHint.full}</span><span
                      class="text-primary/50 material-symbols-outlined ml-1 align-middle text-[16px]"
