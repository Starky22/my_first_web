                  <p class="font-bold">
                    {items.straightening.name} <span class="js-length-hint" data-full={hint.full} data-kratek={hint.short} data-stredni={hint.medium} data-dlouhe={hint.long}>{hint.full}</span>
                  </p><span class="price-leader" aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full={items.straightening.full}
                    data-kratek={items.straightening.short}
                    data-stredni={items.straightening.medium}
                    data-dlouhe={items.straightening.long}
                    >{items.straightening.full}</span>
                </div>
                <div
