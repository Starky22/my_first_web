                    class="price-leader"
                    aria-hidden="true"></span><span
                    class="js-length-price text-primary shrink-0 font-bold whitespace-nowrap"
                    data-full={items.wash.full}
                    data-kratek={items.wash.short}
                    data-stredni={items.wash.medium}
                    data-dlouhe={items.wash.long}
                    >{items.wash.full}</span>
                </div>
                <div
                  class="price-row"
                >
                  <p class="font-bold">{items.cut.name}</p><span
                    class="price-leader"
                    aria-hidden="true"></span><span
                    class="text-primary shrink-0 font-bold whitespace-nowrap"
