                    data-kratek={items.curling.short}
                    data-stredni={items.curling.medium}
                    data-dlouhe={items.curling.long}
                    >{items.curling.full}</span>
                </div>
              </div>
            </div>
            <div class="reveal active">
              <h3
                class="font-Inter text-primary border-primary/20 mb-6 border-b pb-2 text-2xl"
