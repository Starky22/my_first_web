                  >
                    {items.efilace.name}<span
                      class="text-primary/50 material-symbols-outlined ml-1 align-middle text-[16px]"
                      >info</span
                    ><span
                      class="price-tooltip bg-surface-container-highest text-on-surface border-outline-variant/30 pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-64 max-w-[calc(100vw-2rem)] rounded-xl border p-3 text-xs font-normal shadow-xl transition-opacity"
                      >{items.efilace.tooltip}</span>
                  </button><span class="price-leader" aria-hidden="true"></span><span
                    class="text-primary shrink-0 font-bold whitespace-nowrap"
                    >{items.efilace.price}</span>
