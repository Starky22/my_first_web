    <section
      class="py-stack-lg px-gutter max-w-container-max mx-auto"
      id="kontakt"
    >
      <div class="gap-stack-md grid lg:grid-cols-2">
        <div class="reveal active">
          <h2 class="font-Inter text-on-surface mb-8 text-2xl">Spojme se</h2>
          <div class="mb-12 space-y-8">
            <div class="flex items-start gap-4">
              <span
                class="material-symbols-outlined text-primary bg-primary/10 rounded-xl p-3"
                >person</span
              >
              <div>
                <p class="text-on-surface font-bold">Petra Kavková</p>
                <p class="text-on-surface-variant">Majitelka & Kadeřnice</p>
              </div>
            </div>
            <div>
              <div class="flex items-center gap-4">
                <a
                  href="tel:+420604172884"
                  class="group flex items-center gap-4"
                >
                  <span
                    class="material-symbols-outlined text-primary bg-primary/10 group-hover:bg-primary rounded-xl p-3 transition-colors duration-300 group-hover:text-white"
                  >
                    phone
                  </span>
                  <span class="text-on-surface font-bold">604 172 884</span>
                </a>
                <button
                  type="button"
                  id="copy-phone"
                  aria-label="Zkopírovat telefonní číslo"
                  class="text-on-surface-variant hover:text-primary inline-flex min-h-11 items-center self-center px-2 text-sm transition-colors duration-300"
                >
                  <span id="phone-copy-text">Zkopírovat číslo</span>
                </button>
              </div>
              <p class="text-on-surface-variant mt-2 pl-16">
                Nemůžete se dovolat? Napište mi SMS, ozvu se vám zpátky.
              </p>
            </div>
            <div>
              <button
                type="button"
                id="copy-address"
                aria-label="Zkopírovat adresu Hliník 34, Bochoř"
                class="group flex cursor-pointer items-start gap-4 border-0 bg-transparent p-0 text-left"
              >
                <span
                  class="material-symbols-outlined text-primary bg-primary/10 group-hover:bg-primary rounded-xl p-3 transition-colors duration-300 group-hover:text-white"
                  >location_on</span
                >
                <span>
                  <span class="text-on-surface group-hover:text-primary font-bold transition-colors duration-300"
                    >Hliník 34, Bochoř</span
                  >
                  <span class="text-on-surface-variant mt-0.5 block">
                    Pohodlné parkování přímo u salónu
                  </span>
                </span>
              </button>
            </div>
          </div>
        </div>

        <div
          class="border-outline-variant/30 group reveal active h-72 max-w-full overflow-hidden rounded-2xl border shadow-lg"
        >
          <iframe
            class="h-full w-full max-w-full"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d510.0010438251734!2d17.422878709678113!3d49.425772104364945!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4713a9aa351cedc5%3A0x19d5e3b032166531!2zS2FkZcWZbmljdHbDrSBQZXRyYQ!5e0!3m2!1scs!2scz!4v1788967789651!5m2!1scs!2scz"
            title="Kadeřnictví Petra na mapě"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>
        </div>
      </div>
    </section>

    <script>
      function setupCopyButton(buttonId, textId, value, idleLabel, copiedLabel) {
        const button = document.getElementById(buttonId);
        const label = document.getElementById(textId);
        if (!button || !label) return;

        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(value);
            label.textContent = copiedLabel;
            setTimeout(() => {
              label.textContent = idleLabel;
            }, 2000);
          } catch (error) {
            console.error("Nepodařilo se zkopírovat text:", error);
          }
        });
      }

      setupCopyButton(
        "copy-phone",
        "phone-copy-text",
        "604 172 884",
        "Zkopírovat číslo",
        "✓ Číslo zkopírováno",
      );

      const copyAddress = document.getElementById("copy-address");
      if (copyAddress) {
        const addressIcon = copyAddress.querySelector(".material-symbols-outlined");
        copyAddress.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText("Hliník 34, Bochoř");
            if (addressIcon) addressIcon.textContent = "check";
            copyAddress.setAttribute(
              "aria-label",
              "Adresa zkopírována: Hliník 34, Bochoř",
            );
            setTimeout(() => {
              if (addressIcon) addressIcon.textContent = "location_on";
              copyAddress.setAttribute(
                "aria-label",
                "Zkopírovat adresu Hliník 34, Bochoř",
              );
            }, 2000);
          } catch (error) {
            console.error("Nepodařilo se zkopírovat adresu:", error);
          }
        });
      }
    </script>
